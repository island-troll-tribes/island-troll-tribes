{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext"],
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "types": ["w3ts"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@entities/*": ["src/entities/*"],
      "@systems/*": ["src/systems/*"],
      "@talents/*": ["src/talents/*"],
      "@items/*": ["src/items/*"],
      "@config/*": ["src/config/*"],
      "@data/*": ["src/data/*"],
      "@ui/*": ["src/ui/*"],
      "@lib/*": ["src/lib/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "tstl": {
    "luaTarget": "5.3",
    "luaBundle": "dist/tstl_output.lua",
    "luaBundleEntry": "src/main.ts",
    "luaLibImport": "require-minimal",
    "noImplicitSelf": true,
    "luaPlugins": [
      { "name": "war3-transformer" }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
