{
  "name": "island-troll-tribes",
  "version": "4.0.0-alpha.1",
  "description": "Island Troll Tribes - W3TS Rewrite (TypeScript for Warcraft III)",
  "private": true,
  "scripts": {
    "build": "tstl -p tsconfig.json",
    "build:map": "node scripts/build-map.mjs",
    "watch": "tstl -p tsconfig.json --watch",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "w3ts": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "typescript-to-lua": "^1.26.0",
    "war3-transformer": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
